# --- база и очередь (на Render подставляются из render.yaml автоматически)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svod
REDIS_URL=redis://localhost:6379/0

# --- хранилище файлов
# s3 — Cloudflare R2 / Backblaze B2 / любое S3-совместимое (продакшен)
# local — папка на диске (только для запуска на ноутбуке)
STORAGE_BACKEND=s3
S3_BUCKET=svod-documents
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=documents

# --- прочее
APP_NAME=СВОД
ORG_NAME=Внутренняя экспертиза
MAX_UPLOAD_MB=80
# INLINE_WORKER=1   # разбор в потоке веб-процесса, без Redis: только локально
